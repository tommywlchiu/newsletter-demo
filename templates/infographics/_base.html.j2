{# Shared shell for every KittyNews infographic. Extending this is what makes the
   four types read as one family. All colour and type comes from brand.json.

   Every card REQUIRES a `source` — an infographic without attribution should be
   impossible to render, not merely discouraged. #}
{% set c = brand.color %}
{% set t = brand.type %}
{% set L = brand.layout %}
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="{{ t.png.webfont_url }}" rel="stylesheet">
<style>
  html, body { margin:0; padding:0; background:transparent; }
  #card {
    width: {{ L.card_width }}px;
    box-sizing: border-box;
    padding: {{ L.card_padding }}px;
    background: {{ c.sand }};
    border-radius: {{ L.radius }}px;
    font-family: {{ t.png.body }};
    color: {{ c.ink }};
    -webkit-font-smoothing: antialiased;
  }
  .eyebrow {
    font-size: 11px; font-weight: 700; letter-spacing: .16em;
    text-transform: uppercase; color: {{ c.marmalade_deep }};
    margin-bottom: 10px;
  }
  h1 {
    font-family: {{ t.png.display }};
    font-size: {{ t.scale.h2 }}px; font-weight: 900; line-height: 1.22;
    letter-spacing: -.012em; margin: 0 0 6px;
  }
  .sub {
    font-size: {{ t.scale.small }}px; line-height: 1.5;
    color: {{ c.muted }}; margin: 0 0 22px;
  }
  h1:last-of-type { margin-bottom: 20px; }
  .source {
    margin-top: 24px; padding-top: 13px;
    border-top: 1px solid {{ c.rule }};
    font-size: {{ t.scale.caption }}px; line-height: 1.45; color: {{ c.muted }};
    /* flex-start, not center: a source line that wraps to two lines would
       otherwise float the dot into the middle of the block */
    display: flex; align-items: flex-start; gap: 7px;
  }
  .source .dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: {{ c.marmalade }}; flex: none; margin-top: 6px;
  }
  {% block styles %}{% endblock %}
</style>
</head>
<body>
<div id="card">
  {% if eyebrow is defined and eyebrow %}<div class="eyebrow">{{ eyebrow }}</div>{% endif %}
  <h1>{{ title }}</h1>
  {% if subtitle is defined and subtitle %}<p class="sub">{{ subtitle }}</p>{% endif %}

  {% block content %}{% endblock %}

  <div class="source"><span class="dot"></span><span>{{ source }}</span></div>
</div>
</body>
</html>
