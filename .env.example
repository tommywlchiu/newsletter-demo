# Copy to .env and fill in. .env is gitignored — secrets live here and nowhere else.

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Google (Sheets / Slides / Drive) ---
# OAuth client downloaded from Google Cloud Console, saved as credentials.json in project root.
# token.json is written automatically on first auth.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

