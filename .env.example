# Copy to .env and fill in. .env is gitignored — secrets live here and nowhere else.

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Research (Perplexity Agent API) ---
# https://www.perplexity.ai/settings/api
# NOTE: build against /v1/agent — the older Sonar chat-completions endpoint
# was retired on 2026-09-27.
PERPLEXITY_API_KEY=

# --- Delivery (Gmail via app password) ---
# NOT OAuth. Enable 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords — it's 16 chars, spaces optional.
# We use SMTP/IMAP directly rather than the Gmail connector because the connector
# strips <img> tags and background colours, which breaks a designed newsletter.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Newsletter defaults ---
NEWSLETTER_FROM_NAME=KittyNews
NEWSLETTER_DEFAULT_TO=

# --- Google (Sheets / Slides / Drive) — only if a workflow needs them ---
# Gmail does NOT use these; see the app password above.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
