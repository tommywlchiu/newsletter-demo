{# The KittyNews cat mark, as a macro so the logo and the guidelines sheet render
   the identical geometry. Never copy these paths — import this instead. #}
{% macro cat(fill, eye, width, cls='mark') -%}
<svg class="{{ cls }}" viewBox="0 0 100 92" width="{{ width }}" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="KittyNews">
  <!-- ears: upright, tips roughly above their own base centre. Splaying them
       outward reads as a fox or bat rather than a cat. -->
  <path d="M17 45 L27 10 L49 29 Z" fill="{{ fill }}" stroke-linejoin="round"/>
  <path d="M83 45 L73 10 L51 29 Z" fill="{{ fill }}" stroke-linejoin="round"/>
  <!-- head -->
  <rect x="13" y="27" width="74" height="61" rx="30" fill="{{ fill }}"/>
  <!-- eyes as negative space: keeps the mark legible when scaled to a favicon.
       Slightly taller than wide so they read as eyes, not punched holes. -->
  <ellipse cx="37" cy="54" rx="5.8" ry="6.6" fill="{{ eye }}"/>
  <ellipse cx="63" cy="54" rx="5.8" ry="6.6" fill="{{ eye }}"/>
  <!-- muzzle: one wedge reads as a nose at 16px where two shapes would mud -->
  <path d="M50 66 L43.5 72.5 L56.5 72.5 Z" fill="{{ eye }}" stroke-linejoin="round"/>
  <!-- whiskers -->
  <g stroke="{{ eye }}" stroke-width="2.4" stroke-linecap="round" opacity="0.85">
    <path d="M20 63 L32 65"/>
    <path d="M20 73 L32 71"/>
    <path d="M80 63 L68 65"/>
    <path d="M80 73 L68 71"/>
  </g>
</svg>
{%- endmacro %}
