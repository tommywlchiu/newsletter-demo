{# Timeline / process flow.
   data: { title, subtitle?, eyebrow?, source, events: [{when, what, detail?, now?}] }

   Vertical because it scales to any number of steps at 600px width, where a
   horizontal timeline would crush the labels. An event may set now:true to mark
   the present moment. #}
{% extends 'templates/infographics/_base.html.j2' %}

{% block styles %}
  .tl { position: relative; padding-left: 30px; }
  .tl::before {
    content: ""; position: absolute; left: 6px; top: 6px; bottom: 6px;
    width: 2px; background: {{ c.rule }};
  }
  .ev { position: relative; padding-bottom: 22px; }
  .ev:last-child { padding-bottom: 0; }
  .ev::before {
    content: ""; position: absolute; left: -30px; top: 3px;
    width: 14px; height: 14px; border-radius: 50%;
    background: {{ c.sand }};
    border: 3px solid {{ c.rule }};
    box-sizing: border-box;
  }
  .ev.now::before {
    background: {{ c.marmalade }};
    border-color: {{ c.marmalade }};
    box-shadow: 0 0 0 4px {{ c.sand }}, 0 0 0 6px {{ c.marmalade }}33;
  }
  .when {
    font-family: {{ t.png.display }}; font-weight: 900;
    font-size: {{ t.scale.small }}px; color: {{ c.marmalade_deep }};
    letter-spacing: -.01em; margin-bottom: 3px;
  }
  .what { font-size: {{ t.scale.small }}px; font-weight: 600; line-height: 1.4; }
  .detail {
    font-size: {{ t.scale.caption }}px; color: {{ c.muted }};
    line-height: 1.5; margin-top: 4px;
  }
{% endblock %}

{% block content %}
<div class="tl">
  {% for e in events %}
  <div class="ev {{ 'now' if e.now is defined and e.now else '' }}">
    <div class="when">{{ e.when }}</div>
    <div class="what">{{ e.what }}</div>
    {% if e.detail is defined and e.detail %}<div class="detail">{{ e.detail }}</div>{% endif %}
  </div>
  {% endfor %}
</div>
{% endblock %}
